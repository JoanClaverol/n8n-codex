# Copy to .env to override defaults (optional — defaults match the course).

# Pin a specific n8n version for reproducibility, e.g. 2.36.8 ("latest" follows the course).
N8N_VERSION=latest

# Timezone used for schedule triggers (course text says Europe/Berlin; this
# cohort's local zone is Europe/Madrid — identical CET/CEST offsets).
GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid
